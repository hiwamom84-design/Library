# Server Configuration
PORT=5000
NODE_ENV=development

# Railway or Local PostgreSQL Database URL
# Format: postgresql://username:password@localhost:5432/library_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/library_db

# Security & Secrets
JWT_SECRET=super-secret-random-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Administrator Credentials
ADMIN_EMAIL=admin@library.krd
ADMIN_PASSWORD=1234554321
ADMIN_NAME=نوح هیوا عومەر

# Automatic Migrations on Startup (true/false)
AUTO_MIGRATE=true
